# Copy to .env.local for local development, or set these in Netlify's
# environment variable settings for production. Never commit real values —
# see CLAUDE.md §0 ("Secrets and IDs go in environment variables, never
# hard-coded").

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave unset to keep
# analytics off entirely — no script loads, no cookies, nothing. Must use
# the NEXT_PUBLIC_ prefix so it's readable client-side (gtag runs in the
# browser); this is the measurement ID itself, not a secret.
NEXT_PUBLIC_GA4_ID=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Leave unset to keep GTM
# off. Use this OR NEXT_PUBLIC_GA4_ID, not both: if your GTM container already
# fires a GA4 tag, setting both double-counts every pageview.
NEXT_PUBLIC_GTM_ID=

# Set to "true" to turn on the 3 reserved ad slots in the article template
# (components/AdSlot.tsx). Leave unset/false until AdSense approval, and
# until public/ads.txt holds a real publisher ID instead of the current
# placeholder.
NEXT_PUBLIC_ADS_ENABLED=false
